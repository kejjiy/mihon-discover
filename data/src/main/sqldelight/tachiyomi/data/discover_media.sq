CREATE TABLE discover_media(
    anilist_id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    alternative_titles TEXT NOT NULL,
    cover_url TEXT,
    description TEXT,
    genres TEXT NOT NULL,
    status TEXT,
    popularity INTEGER,
    average_score INTEGER,
    chapters INTEGER,
    start_year INTEGER,
    updated_at INTEGER NOT NULL
);

getDiscoverMedia:
SELECT * FROM discover_media
WHERE anilist_id = :anilistId;

upsertDiscoverMedia:
INSERT OR REPLACE INTO discover_media(
    anilist_id, title, alternative_titles, cover_url, description, genres, status,
    popularity, average_score, chapters, start_year, updated_at
) VALUES (
    :anilistId, :title, :alternativeTitles, :coverUrl, :description, :genres, :status,
    :popularity, :averageScore, :chapters, :startYear, :updatedAt
);
