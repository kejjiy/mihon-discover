CREATE TABLE discover_source_matches(
    anilist_id INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    manga_url TEXT NOT NULL,
    confidence INTEGER NOT NULL,
    chapter_count INTEGER,
    completed INTEGER NOT NULL,
    checked_at INTEGER NOT NULL,
    PRIMARY KEY(anilist_id, source_id, manga_url),
    FOREIGN KEY(anilist_id) REFERENCES discover_media(anilist_id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX discover_source_matches_manga ON discover_source_matches(source_id, manga_url)
WHERE confidence = 0;

getDiscoverMatches:
SELECT * FROM discover_source_matches
WHERE anilist_id = :anilistId;

upsertDiscoverMatch:
INSERT OR REPLACE INTO discover_source_matches(
    anilist_id, source_id, manga_url, confidence, chapter_count, completed, checked_at
) VALUES (
    :anilistId, :sourceId, :mangaUrl, :confidence, :chapterCount, :completed, :checkedAt
);
